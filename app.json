{
  "expo": {
    "name": "OpenCity",
    "slug": "opencity-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "opencity",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "org.houhackathon.opencity",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#166a53",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      "./plugins/with-short-cmake-paths",
      ["expo-location", { "locationWhenInUsePermission": "Cho phép OpenCity gắn vị trí vào phản ánh của bạn." }],
      ["expo-image-picker", { "photosPermission": "Cho phép OpenCity chọn ảnh cho phản ánh của bạn.", "cameraPermission": "Cho phép OpenCity chụp ảnh cho phản ánh của bạn." }],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
